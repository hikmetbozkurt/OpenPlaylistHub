@model List<SongResponse>

@{
    ViewData["Title"] = "Songs";
}

<h1>Songs</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Album</th>
            <th>Duration</th>
            <th>Rating</th>
            <th>Release Date</th>
            <th>Genres</th>
            <th>Artist</th>
            <th>Total Streams</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Id</td>
            <td>@item.Title</td>
            <td>@item.AlbumTitle</td>
            <td>@(item.DurationSeconds.HasValue ? TimeSpan.FromSeconds(item.DurationSeconds.Value).ToString(@"mm\:ss") : "-")</td>
            <td>@item.AverageRating</td>
            <td>@(item.ReleaseDate.HasValue ? item.ReleaseDate.Value.ToShortDateString() : "-")</td>
            <td>@item.GenreNames</td>
            <td>@item.ArtistName</td>
            <td>@item.TotalStreams</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

